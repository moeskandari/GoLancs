# Backend Environment Variables for Container Deployment
# Copy this to .env when running in Docker/Podman

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (values should match docker-compose.yml)
DB_HOST=group1db
DB_PORT=5432
DB_NAME=travel_routes
DB_USER=postgres
DB_PASSWORD=group1

